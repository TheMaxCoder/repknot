#!/usr/bin/env -S deno run --ext=ts --allow-net --allow-env --allow-read
// Repknot CLI: reads/writes Supabase as a normal signed-in user (RLS applies).
// Never uses a service-role/secret key. Config comes from the repo's untracked .env.
//
//   scripts/repknot whoami
//   scripts/repknot list [count]
//   scripts/repknot show <#number|uuid>
//   scripts/repknot set-notes <#number|uuid> <notes>
//   scripts/repknot log-test            # synthetic session: one exercise, one set (save_session)
//   scripts/repknot delete <#number|uuid>
//   scripts/repknot seed-exercises <exercises.csv>
//   scripts/repknot rename-exercise <slug|uuid> <new name>  # catalog name; past sessions keep theirs
//   scripts/repknot publish-program <program.json> [--inactive]
//   scripts/repknot publish-notes <notes.json>   # coach brief shown on the phone's Home (task 034)
//   scripts/repknot notes                         # latest published brief
//   scripts/repknot set-password                  # change to REPKNOT_NEW_PASSWORD from .env
//   add --as test2 to act as the second (test) user
import { createClient } from "npm:@supabase/supabase-js@2";
import { parse } from "jsr:@std/csv@1";

const root = new URL("..", import.meta.url).pathname;
const env: Record<string, string> = {};
for (const line of (await Deno.readTextFile(`${root}.env`)).split("\n")) {
  const m = line.match(/^([A-Za-z0-9_]+)=(.*)$/);
  if (m) env[m[1]] = m[2].trim();
}

const args = [...Deno.args];
const asIndex = args.indexOf("--as");
const asTest2 = asIndex >= 0 && args[asIndex + 1] === "test2";
if (asIndex >= 0) args.splice(asIndex, 2);
const [command, arg] = args;

function need(name: string): string {
  if (!env[name]) throw new Error(`${name} is empty in .env`);
  return env[name];
}

const supabase = createClient(need("SUPABASE_URL"), need("SUPABASE_PUBLISHABLE_KEY"), {
  auth: { persistSession: false },
});
const { data: auth, error: authError } = await supabase.auth.signInWithPassword({
  email: need(asTest2 ? "REPKNOT_TEST2_EMAIL" : "REPKNOT_EMAIL"),
  password: need(asTest2 ? "REPKNOT_TEST2_PASSWORD" : "REPKNOT_PASSWORD"),
});
if (authError) throw authError;

function sessionFilter(ref: string | undefined) {
  if (!ref) throw new Error("give a session #number or uuid");
  return ref.startsWith("#") ? { column: "number", value: ref.slice(1) } : { column: "id", value: ref };
}

function fail(error: unknown): never {
  console.error(error);
  Deno.exit(1);
}

switch (command) {
  case "whoami":
    console.log(`${auth.user.email} (${auth.user.id})`);
    break;

  case "list": {
    const { data, error } = await supabase.from("workout_sessions")
      .select("id, number, performed_on, title, revision, source, session_exercises(count)")
      .order("performed_on", { ascending: false }).order("number", { ascending: false })
      .limit(Number(arg ?? 10));
    if (error) fail(error);
    if (data.length === 0) console.log("(no sessions)");
    for (const s of data) {
      const n = (s.session_exercises as { count: number }[])[0]?.count ?? 0;
      console.log(`#${s.number}  ${s.performed_on}  ${s.title ?? "(untitled)"}  · ${n} exercise${n === 1 ? "" : "s"} · rev ${s.revision} · ${s.source}  ${s.id}`);
    }
    break;
  }

  case "show": {
    const f = sessionFilter(arg);
    const { data, error } = await supabase.from("workout_sessions")
      .select("*, session_exercises(*, session_sets(*))").eq(f.column, f.value).maybeSingle();
    if (error) fail(error);
    if (!data) fail(`no session ${arg} visible to ${auth.user.email}`);
    const byPosition = (a: { position: number }, b: { position: number }) => a.position - b.position;
    data.session_exercises.sort(byPosition);
    for (const e of data.session_exercises) e.session_sets.sort(byPosition);
    console.log(JSON.stringify(data, null, 2));
    break;
  }

  case "set-notes": {
    const f = sessionFilter(arg);
    const notes = args[2];
    if (notes === undefined) fail("give notes text");
    const { data, error } = await supabase.from("workout_sessions")
      .update({ notes, source: "cli" }).eq(f.column, f.value).select("number");
    if (error) fail(error);
    if (!data.length) fail("session not found");
    console.log(`updated #${data[0].number}`);
    break;
  }

  case "log-test": {
    const today = new Date().toISOString().slice(0, 10);
    const { error: exerciseError } = await supabase.from("exercises").upsert(
      { slug: "synthetic-bench", name: "Dumbbell bench press (synthetic)", default_unit: "kg" },
      { onConflict: "user_id,slug", ignoreDuplicates: true });
    if (exerciseError) fail(exerciseError);
    const { data: session, error } = await supabase.rpc("save_session", { payload: {
      performed_on: today, title: "CLI connectivity check (synthetic)",
      exercises: [{ exercise: "synthetic-bench", sets: [{ load: 32.5, unit: "kg", reps: 7, rir: 3 }] }],
    } });
    if (error) fail(error);
    console.log(`created #${session.number} ${session.id}`);
    break;
  }

  case "delete": {
    const f = sessionFilter(arg);
    const { data, error } = await supabase.from("workout_sessions").delete().eq(f.column, f.value).select("number");
    if (error) fail(error);
    console.log(data.length ? `deleted #${data[0].number}` : `nothing deleted (not found or not yours)`);
    break;
  }

  case "seed-exercises": {
    if (!arg) fail("give an exercises CSV file");
    const csv = await Deno.readTextFile(arg);
    const header = parse(csv)[0] ?? [];
    const missing = ["slug", "name", "default_unit"].filter((column) => !header.includes(column));
    if (missing.length) fail(`missing CSV columns: ${missing.join(", ")}`);
    const rows = parse(csv, { skipFirstRow: true }).map((row) => ({
      slug: row.slug, name: row.name, default_unit: row.default_unit || null,
      notes: row.airtable_notes || null,
    }));
    const existing = new Set<string>();
    for (let offset = 0;; offset += 1000) {
      const { data, error } = await supabase.from("exercises").select("slug")
        .order("slug").range(offset, offset + 999);
      if (error) fail(error);
      for (const exercise of data) existing.add(exercise.slug);
      if (data.length < 1000) break;
    }
    const updated = rows.filter((row) => existing.has(row.slug)).length;
    const { error } = await supabase.from("exercises").upsert(rows, { onConflict: "user_id,slug" });
    if (error) fail(error);
    console.log(`seeded ${rows.length} exercises (${rows.length - updated} new, ${updated} updated)`);
    break;
  }

  case "rename-exercise": {
    const name = (args[2] ?? "").trim();
    if (!arg || !name) fail("give an exercise slug or uuid and the new name");
    const column = /^[0-9a-f-]{36}$/.test(arg) ? "id" : "slug";
    const { data: before, error: readError } = await supabase.from("exercises")
      .select("id, slug, name").eq(column, arg).maybeSingle();
    if (readError) fail(readError);
    if (!before) fail(`no exercise ${arg} visible to this account`);
    const { error } = await supabase.from("exercises").update({ name }).eq("id", before.id);
    if (error) fail(error);
    console.log(`renamed ${before.slug}: "${before.name}" → "${name}" (sessions keep the name they were logged with)`);
    break;
  }

  case "publish-program": {
    if (!arg) fail("give a program JSON file");
    const payload = JSON.parse(await Deno.readTextFile(arg));
    const { data, error } = await supabase.rpc("publish_program", {
      payload, activate: !args.includes("--inactive"),
    });
    if (error) {
      if (error.code === "23505") fail(`${payload.program} v${payload.version} is already published; bump "version" to publish a change`);
      fail(error);
    }
    console.log(`published ${data.key} v${data.version} (${data.id}) · ${data.is_active ? "active" : "inactive"}${data.supersedes ? ` · supersedes ${data.supersedes}` : ""}`);
    break;
  }

  case "publish-notes": {
    if (!arg) fail("give a notes JSON file");
    const brief = JSON.parse(await Deno.readTextFile(arg));
    const kinds = ["progress", "hold", "technique", "recovery", "focus"];
    const problems: string[] = [];
    const headline = typeof brief.headline === "string" ? brief.headline.trim() : "";
    if (!headline || headline.length > 120) problems.push("headline: 1–120 characters");
    if (brief.based_on !== undefined && !/^\d{4}-\d{2}-\d{2}$/.test(brief.based_on)) problems.push("based_on: YYYY-MM-DD");
    if (!Array.isArray(brief.items) || brief.items.length < 1 || brief.items.length > 8) problems.push("items: 1–8 entries");
    const items = Array.isArray(brief.items) ? brief.items : [];
    items.forEach((item: Record<string, unknown>, i: number) => {
      if (!kinds.includes(item.kind as string)) problems.push(`items[${i}].kind: one of ${kinds.join(", ")}`);
      const text = typeof item.text === "string" ? item.text.trim() : "";
      if (!text || text.length > 200) problems.push(`items[${i}].text: 1–200 characters`);
      if (item.exercise !== undefined && typeof item.exercise !== "string") problems.push(`items[${i}].exercise: an exercise slug`);
    });
    if (problems.length) fail(`invalid notes file:\n  ${problems.join("\n  ")}`);
    const slugs = [...new Set(items.map((item: Record<string, string>) => item.exercise).filter(Boolean))] as string[];
    const ids = new Map<string, string>();
    if (slugs.length) {
      const { data, error } = await supabase.from("exercises").select("id, slug").in("slug", slugs);
      if (error) fail(error);
      for (const e of data) ids.set(e.slug, e.id);
      const unknown = slugs.filter((slug) => !ids.has(slug));
      if (unknown.length) fail(`unknown exercise slugs: ${unknown.join(", ")}`);
    }
    const { data, error } = await supabase.from("coach_notes").insert({
      headline, based_on: brief.based_on ?? null, source: "cli",
      items: items.map((item: Record<string, string>) => ({ kind: item.kind, text: item.text.trim(),
        ...(item.exercise ? { exercise_id: ids.get(item.exercise) } : {}) })),
    }).select("id, published_at").single();
    if (error) fail(error);
    console.log(`published coach notes (${items.length} item${items.length === 1 ? "" : "s"}) ${data.id} at ${data.published_at}`);
    break;
  }

  case "set-password": {
    const current = asTest2 ? "REPKNOT_TEST2_PASSWORD" : "REPKNOT_PASSWORD";
    const next = asTest2 ? "REPKNOT_TEST2_NEW_PASSWORD" : "REPKNOT_NEW_PASSWORD";
    const password = need(next);
    if (password.length < 16) fail(`${next} is shorter than 16 characters`);
    const { error } = await supabase.auth.updateUser({ password });
    if (error) fail(error);
    console.log(`Password changed for ${auth.user.email}. In .env, copy ${next}'s value to ${current}, then delete the ${next} line.`);
    break;
  }

  case "notes": {
    const { data, error } = await supabase.from("coach_notes")
      .select("id, published_at, based_on, headline, items").order("published_at", { ascending: false }).limit(1).maybeSingle();
    if (error) fail(error);
    if (!data) { console.log("(no coach notes)"); break; }
    const names = new Map<string, string>();
    const ids = data.items.map((item: Record<string, string>) => item.exercise_id).filter(Boolean);
    if (ids.length) {
      const { data: exercises, error: exerciseError } = await supabase.from("exercises").select("id, name").in("id", ids);
      if (exerciseError) fail(exerciseError);
      for (const e of exercises) names.set(e.id, e.name);
    }
    console.log(`${data.headline}  · ${data.published_at.slice(0, 10)}${data.based_on ? ` (through ${data.based_on})` : ""}  ${data.id}`);
    for (const item of data.items) {
      console.log(`  [${item.kind}] ${item.exercise_id ? `${names.get(item.exercise_id) ?? "?"}: ` : ""}${item.text}`);
    }
    break;
  }

  default:
    console.log("usage: scripts/repknot [--as test2] whoami | list [n] | show <#n|uuid> | set-notes <#n|uuid> <notes> | log-test | delete <#n|uuid> | seed-exercises <exercises.csv> | rename-exercise <slug|uuid> <name> | publish-program <program.json> [--inactive] | publish-notes <notes.json> | notes");
    Deno.exit(command ? 1 : 0);
}
