#!/usr/bin/env -S python3 -I
"""Independent AI review of outgoing commits for personal data and secrets.

Usage: scripts/ai-privacy-review <rev-list args>   e.g. origin/main..HEAD, or HEAD --not --remotes

Sends each commit's message and added lines (never the private denylist) to a reviewer
model through `pi`, with no tools, no project context and no session. The content is about
to be published anyway. Exits 0 only if every chunk ends with "VERDICT: PASS"; any
finding, error, timeout or unreadable answer blocks (fail closed).
Env: PUSH_REVIEW_MODEL (default openai-codex/gpt-6.1-sol, not the delegation worker's model), PUSH_REVIEW_THINKING (medium).
"""
import os, re, subprocess, sys, tempfile

MODEL = os.environ.get("PUSH_REVIEW_MODEL", "openai-codex/gpt-6.1-sol")
THINKING = os.environ.get("PUSH_REVIEW_THINKING", "medium")
CHUNK = 80_000
TIMEOUT = 900

SYSTEM = """You review commits that are about to be pushed to a PUBLIC GitHub repository for a
personal Android workout logger. The owner uses the app for their own training, so their
real health and training data exists, but it must never appear in the repository.

Flag anything in the commit messages or added lines that plausibly is:
- real personal data: body measurements or goals, real workout results (loads, reps, dates
  of real sessions), real set or session notes, injuries, health context, routines;
- identifying details: names other than the published author, emails, phone numbers,
  addresses, device models or serials, local usernames or absolute home paths;
- backend identifiers: Supabase project refs/URLs, database hosts;
- secrets: passwords, API keys, tokens, private keys, JWTs;
- AI attribution lines (Co-Authored-By trailers, "Generated with ..." lines).

Do NOT flag: clearly synthetic or invented values (test fixtures, "synthetic"/"demo"/"test"
data, spec examples like `25 kg x 10`), placeholder emails (example.com, test.invalid),
generic exercise names, documentation that describes these rules, or relative paths.
Judge whether a value looks copied from real records; when it plausibly is real and you
are unsure, flag it.

Answer format, nothing else:
FINDING: <commit> <file or "message">: <what> - <why>   (one line per finding; none if clean)
VERDICT: PASS   or   VERDICT: BLOCK
"""


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def commit_text(c):
    out = [f"=== commit {c[:7]}", git("log", "-1", "--format=%B", c).strip(), "--- added lines"]
    path = None
    for line in git("show", "--format=", "-U0", "--no-color", "--src-prefix=a/", "--dst-prefix=b/", "--first-parent", c).splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else None
            if path:
                out.append(f"## {path}")
        elif line.startswith("Binary files ") and " and b/" in line:
            out.append(f"## binary file added or changed: {line.split(' and b/', 1)[1].rsplit(' differ', 1)[0]}")
        elif line.startswith("+") and not line.startswith("+++") and path:
            out.append(line[1:])
    return "\n".join(out) + "\n"


def chunks(commits):
    buf = ""
    for c in commits:
        text = commit_text(c)
        while len(text) > CHUNK:
            if buf:
                yield buf; buf = ""
            yield text[:CHUNK]; text = "=== (continued)\n" + text[CHUNK:]
        if len(buf) + len(text) > CHUNK and buf:
            yield buf; buf = ""
        buf += text
    if buf:
        yield buf


def review(n, total, text):
    with tempfile.TemporaryDirectory() as tmp:
        payload = os.path.join(tmp, "outgoing.txt")
        with open(payload, "w", encoding="utf-8") as f:
            f.write(text)
        cmd = ["pi", "-p", "--no-session", "--no-tools", "--no-extensions", "--no-skills",
               "--no-context-files", "--no-mcp", "--no-prompt-templates", "-na",
               "--model", MODEL, "--thinking", THINKING, "--system-prompt", SYSTEM,
               f"@{payload}", "Review the attached outgoing commits."]
        try:
            r = subprocess.run(cmd, cwd=tmp, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=TIMEOUT)
        except subprocess.TimeoutExpired:
            return False, [f"chunk {n}/{total}: reviewer timed out"]
    answer = r.stdout.strip()
    verdicts = re.findall(r"^VERDICT:\s*(PASS|BLOCK)\s*$", answer, re.M)
    findings = [l.strip() for l in answer.splitlines() if l.strip().startswith("FINDING:")]
    if r.returncode != 0 or not verdicts:
        detail = (r.stderr.strip() or answer)[-500:]
        return False, [f"chunk {n}/{total}: no readable verdict (exit {r.returncode}): {detail}"]
    return verdicts[-1] == "PASS" and not findings, findings


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return 0 if argv else 2
    commits = git("rev-list", "--reverse", *argv).split()
    if not commits:
        print("ai-privacy-review: nothing to review"); return 0
    parts = list(chunks(commits))
    print(f"ai-privacy-review: {len(commits)} commit(s) in {len(parts)} chunk(s), reviewer {MODEL}", file=sys.stderr)
    ok_all, all_findings = True, []
    for i, text in enumerate(parts, 1):
        print(f"ai-privacy-review: chunk {i}/{len(parts)}…", file=sys.stderr)
        ok, findings = review(i, len(parts), text)
        ok_all &= ok
        all_findings += findings
    for f in all_findings:
        print(f"  {f}", file=sys.stderr)
    print(f"ai-privacy-review: {'PASS' if ok_all else 'BLOCK'}", file=sys.stderr)
    return 0 if ok_all else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
